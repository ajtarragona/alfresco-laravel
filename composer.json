{
    "name": "ajtarragona/alfresco-laravel",
    "keywords": [
        "laravel5",
        "laravel",
        "alfresco"
    ],
    "license": "MIT",
    "description": "Integration of Alfresco in Laravel",
    "authors": [
        {
            "name": "Ruben Macias",
            "email": "ruben.macias@studiogenesis.es"
        },
        {
            "name": "Txomin Medrano",
            "email": "tmedrano@tarragona.cat"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "league/flysystem": "^3.0",
        "league/flysystem-azure-blob-storage": "^3.0",
        "guzzlehttp/guzzle": ">=6.0"
    },
    "autoload": {
        "psr-4": {
            "Ajtarragona\\AlfrescoLaravel\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ajtarragona\\AlfrescoLaravel\\AlfrescoLaravelServiceProvider"
            ],
            "aliases": {
                "Alfresco": "Ajtarragona\\AlfrescoLaravel\\Facades\\Alfresco"
            }
        }
    }
}